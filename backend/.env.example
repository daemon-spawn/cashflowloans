FLASK_ENV=development
SECRET_KEY=change-me

# Render Postgres connection string
DATABASE_URL=postgresql+psycopg://cashflow:cashflow@localhost:5432/cashflow

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase — staff auth (JWT verification) and document storage
SUPABASE_URL=https://qazfvknrhrcewgosljgf.supabase.co
# The project's secret key (sb_secret_…) or legacy service_role key. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# "supabase" in production, "local" stores files under instance/uploads for development
STORAGE_BACKEND=local

# Only these Supabase users may use the CRM API
STAFF_EMAILS=owner@example.com,developer@example.com

# Cloudflare Turnstile secret for public forms (leave empty to disable locally)
TURNSTILE_SECRET_KEY=

# Outgoing email for new-application / contact notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=info@cashflowloans.co.za

# Rate-limit storage; use Render Key Value (redis://…) in production
RATELIMIT_STORAGE_URI=memory://
